# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Verejná adresa webu (pre sitemap.xml a robots.txt). Na localhoste ju netreba meniť.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Analytika (Google Analytics 4 + Microsoft Clarity)
# Skopíruj tento súbor ako `.env` a doplň svoje ID, potom reštartuj `npm run dev`.
# Skripty sa vložia do <head> každej stránky (dev aj build), aj na localhoste.
# ---------------------------------------------------------------------------

# GA4: Admin -> Data streams -> Web -> Measurement ID (formát G-XXXXXXXXXX)
GA_MEASUREMENT_ID=

# Clarity: clarity.microsoft.com -> projekt -> Settings -> Overview -> Project ID (napr. abcd1234ef)
CLARITY_PROJECT_ID=

# true  = lišta so súhlasom; do súhlasu posiela GA4 len anonymné pingy bez cookies (Consent Mode v2)
# false = súhlas sa predpokladá (vhodné len na lokálne testovanie, nie pre verejný web v EÚ)
ANALYTICS_REQUIRE_CONSENT=true

# true = GA4 debug_mode, udalosti uvidíš v GA4 -> Admin -> DebugView
ANALYTICS_DEBUG=false
